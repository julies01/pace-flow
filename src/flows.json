    {
        "id": "node_init_simulation",
        "type": "function",
        "z": "7e882834a913dab0",
        "name": "init simulation",
        "func": "const block = flow.get(\"sessionBlock\");\nif (!block) {\n    node.warn(\"Aucun bloc de session trouvé !\");\n    return null;\n}\n\nconst vitesseMs = (block.vitesse * 1000) / 3600;\nconst dureeTotaleRep = Math.round(block.distance / vitesseMs);\n\nflow.set(\"sim\", {\n    running: true,\n    repActuelle: 1,\n    repTotal: block.repetitions,\n    distance: block.distance,\n    vitesse: block.vitesse,\n    allure: block.allure,\n    recuperation: block.recuperation,\n    distanceParcourue: 0,\n    secondesRep: 0,\n    enPause: false,\n    secondesPause: 0,\n    termine: false,\n    dureeTotaleRep: dureeTotaleRep\n});\n\nreturn { payload: \"started\" };",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1300,
        "y": 260,
        "wires": [
