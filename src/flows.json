    {
        "id": "8ca5d55797a16df8",
        "type": "function",
        "z": "7e882834a913dab0",
        "name": "calcul vitesse",
        "func": "const e_allure = msg.payload[\"e_allure\"]\nconst c_allure = msg.payload[\"c_allure\"]\nconst r_allure = msg.payload[\"r_allure\"]\n\nfunction parseAllureToSeconds(allureString) {\n    const regex = /(?:(\\d+)[':])?(\\d{1,2})/;\n\n    const match = allureString.match(regex);\n\n    if (!match) {\n        throw new Error(`Format d'allure non reconnu : \"${allureString}\"`);\n    }\n\n    const minutes = match[1] ? parseInt(match[1], 10) : 0;\n    const seconds = parseInt(match[2], 10);\n\n    if (seconds >= 60) {\n        throw new Error(\"Les secondes doivent être < 60.\");\n    }\n\n    const secs = minutes * 60 + seconds;\n    const heure = secs/3600;\n    const resultat = 1/heure;\n    return resultat.toFixed(2);\n}\n\nmsg.payload.e_vitesse = parseAllureToSeconds(e_allure);\nmsg.payload.c_vitesse = parseAllureToSeconds(c_allure);\nmsg.payload.r_vitesse = parseAllureToSeconds(r_allure);\n\nconsole.log(msg.payload)\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 120,
        "wires": [
