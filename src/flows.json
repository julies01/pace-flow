    {
        "id": "591893cdf2b555b4",
        "type": "function",
        "z": "7e882834a913dab0",
        "name": "formateur écran",
        "func": "flow.set(\"lastSimData\", msg.payload);\nconst selected1 = flow.get(\"selectedWidget1\") || \"vitesse\";\nconst selected2 = flow.get(\"selectedWidget2\") || \"repetition\";\nconst d = msg.payload;\nconst block = flow.get(\"sessionBlock\") || {};\n\nconst labels = {\n    repetition: \"Répétition\",\n    d_parcourue: \"Distance parcourue\",\n    d_restante: \"Distance restante\",\n    t_ecoule: \"Temps écoulé\",\n    t_restant: \"Temps restant\",\n    vitesse: \"Vitesse\",\n    allure: \"Allure\"\n};\n\nconst units = {\n    repetition: \"\",\n    d_parcourue: \"m\",\n    d_restante: \"m\",\n    t_ecoule: \"min:sec\",\n    t_restant: \"min:sec\",\n    vitesse: \"km/h\",\n    allure: \"min/km\"\n};\n\nfunction getValue(selected, d, block) {\n    if (d.termine) return \"✅ Terminé !\";\n    if (d.enPause) {\n        const pauseValues = {\n            repetition: `${d.repActuelle} / ${d.repTotal}`,\n            d_parcourue: \"⏸\",\n            d_restante: \"⏸\",\n            t_ecoule: `${d.pauseRestante}s`,\n            t_restant: \"—\",\n            vitesse: \"⏸\",\n            allure: \"⏸\"\n        };\n        return pauseValues[selected];\n    }\n    const values = {\n        repetition: `${d.repActuelle} / ${d.repTotal}`,\n        d_parcourue: `${d.distanceParcourue}`,\n        d_restante: `${d.distanceRestante}`,\n        t_ecoule: d.tempsEcoule,\n        t_restant: d.tempsRestant,\n        vitesse: `${parseFloat(flow.get(\"vitesse\")).toFixed(2)}`,\n        allure: d.allure\n    };\n    return values[selected];\n}\n\nmsg.payload = {\n    label1: labels[selected1],\n    value1: getValue(selected1, d, block),\n    unit1: units[selected1],\n    label2: labels[selected2],\n    value2: getValue(selected2, d, block),\n    unit2: units[selected2]\n};\nreturn msg;",
