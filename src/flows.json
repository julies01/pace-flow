        "z": "7e882834a913dab0",
        "name": "tick simulation",
        "func": "const sim = flow.get(\"sim\");\nif (!sim || !sim.running) return null;\n\nconst vitesseMs = (sim.vitesse * 1000) / 3600;\nconst dureeTotaleRep = sim.dureeTotaleRep;\n\nif (sim.enPause) {\n    sim.secondesPause++;\n\n    if (sim.secondesPause >= sim.recuperation) {\n        sim.enPause = false;\n        sim.secondesPause = 0;\n        sim.repActuelle++;\n        sim.distanceParcourue = 0;\n        sim.secondesRep = 0;\n\n        if (sim.repActuelle > sim.repTotal) {\n            sim.running = false;\n            sim.termine = true;\n            flow.set(\"sim\", sim);\n            return { payload: { termine: true } };\n        }\n    }\n} else {\n    sim.secondesRep++;\n    sim.distanceParcourue = Math.min(\n        Math.round(vitesseMs * sim.secondesRep),\n        sim.distance\n    );\n\n    if (sim.distanceParcourue >= sim.distance) {\n        if (sim.repActuelle < sim.repTotal) {\n            sim.enPause = true;\n            sim.secondesPause = 0;\n        } else {\n            sim.running = false;\n            sim.termine = true;\n            flow.set(\"sim\", sim);\n            return { payload: { termine: true } };\n        }\n    }\n}\n\nflow.set(\"sim\", sim);\n\nconst tempsRestant = Math.max(0, dureeTotaleRep - sim.secondesRep);\nconst fmt = s => `${Math.floor(s/60)}:${String(s%60).padStart(2,'0')}`;\n\nreturn {\n    payload: {\n        enPause: sim.enPause,\n        pauseRestante: sim.recuperation - sim.secondesPause,\n        repActuelle: sim.repActuelle,\n        repTotal: sim.repTotal,\n        allure : sim.allure,\n        distanceParcourue: sim.distanceParcourue,\n        distanceRestante: Math.max(0, sim.distance - sim.distanceParcourue),\n        tempsEcoule: fmt(sim.secondesRep),\n        tempsRestant: fmt(tempsRestant),\n        termine: false\n    }\n};",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
