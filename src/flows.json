        "name": "formateur affichage",
        "func": "const d = msg.payload;\n\nif (d.termine) {\n    node.send([\n        { payload: \"✅ Terminé !\" },\n        { payload: \"—\" },\n        { payload: \"—\" },\n        { payload: \"—\" },\n        { payload: \"—\" }\n    ]);\n    return null;\n}\n\nif (d.enPause) {\n    node.send([\n        { payload: `${d.repActuelle} / ${d.repTotal}` },\n        { payload: \"⏸ Récup\" },\n        { payload: \"⏸ Récup\" },\n        { payload: `${d.pauseRestante}s` },\n        { payload: \"—\" }\n    ]);\n    return null;\n}\n\nnode.send([\n    { payload: `${d.repActuelle} / ${d.repTotal}` },\n    { payload: `${d.distanceParcourue} m` },\n    { payload: `${d.distanceRestante} m` },\n    { payload: d.tempsEcoule },\n    { payload: d.tempsRestant }\n]);\nreturn null;",
